---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<div>
			<p class="footer-brand">Overcut<sup>&trade;</sup></p>
			<p>A playable racing concept in development.</p>
		</div>

		<div class="footer-legal">
			<p>Overcut&trade; is a trademark of Casey Irvine. All rights reserved.</p>
			<p>&copy; {year} Casey Irvine.</p>
			<p>
				VALORANT is a trademark of Riot Games. Overcut is not affiliated with Riot Games.
			</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding-block: 3rem;
		border-top: 1px solid color-mix(in oklab, var(--color-paper) 15%, transparent);
		background: var(--color-night);
		color: var(--color-paper-muted);
	}

	.footer-grid {
		display: grid;
		gap: 2rem;
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.footer-grid p {
		margin: 0;
	}

	.footer-grid p + p {
		margin-top: 0.4rem;
	}

	.footer-brand {
		color: var(--color-paper);
		font-family: var(--font-display);
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.footer-brand sup {
		margin-left: 0.12em;
		color: var(--color-acid);
		font-size: 0.3em;
		vertical-align: 1.7em;
	}

	.footer-legal {
		max-width: 38rem;
	}

	@media (min-width: 48rem) {
		.footer-grid {
			grid-template-columns: 1fr 1.4fr;
			align-items: end;
		}

		.footer-legal {
			justify-self: end;
			text-align: right;
		}
	}
</style>
