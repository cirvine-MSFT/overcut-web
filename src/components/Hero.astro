---
/**
 * The hero.
 *
 * `.hero__visual` is the drop-in point for artwork. It is a self-contained,
 * absolutely-positioned, `aria-hidden` layer sitting behind the content, so
 * replacing the CSS treatment with an `<Image />` later is a swap of this one
 * element and nothing else — the content layer does not need to move.
 *
 * Until then the treatment is deliberately typographic and abstract. There is
 * no car imagery on this site, on purpose: the only vehicle in the game today
 * is Epic's Unreal Engine template placeholder, which is scheduled for deletion
 * and is not ours to present as Overcut.
 */
---

<section
	class="hero relative isolate flex min-h-[max(28rem,62svh)] items-center overflow-hidden border-b border-line md:min-h-[max(32rem,78svh)]"
>
	<!-- HERO VISUAL — replace this element with artwork when it exists. -->
	<div class="hero__visual absolute inset-0 -z-10" aria-hidden="true">
		<div class="hero__wash absolute inset-0"></div>
		<div class="hero__rules absolute inset-0"></div>
		<div class="hero__cut absolute inset-0"></div>
	</div>

	<div class="mx-auto w-full max-w-5xl px-6 py-(--spacing-section) sm:px-8">
		<p class="hero__eyebrow flex items-center gap-3 text-xs text-fg-muted uppercase sm:text-sm">
			<span class="hero__tick" aria-hidden="true"></span>
			In development
		</p>

		<h1 class="mt-6 font-display leading-[0.82] font-bold sm:mt-8">
			<span class="hero__wordmark block text-(length:--text-wordmark)">
				Overcut<span class="hero__tm text-accent-soft">™</span>
			</span>
		</h1>

		<p
			class="mt-8 max-w-[34ch] text-xl leading-tight text-balance text-fg sm:mt-10 sm:text-3xl md:text-4xl"
		>
			A serious, collisionless competitive racer where precise driving wins races and
			strategy determines who can sustain it.
		</p>
	</div>
</section>

<style>
	.hero {
		background-color: var(--color-ink);
	}

	/* A single warm bloom, offset so the composition is not centred and dull. */
	.hero__wash {
		background:
			radial-gradient(
				60rem 42rem at 8% -14%,
				color-mix(in oklab, var(--color-accent) 24%, transparent),
				transparent 62%
			),
			radial-gradient(
				52rem 36rem at 96% 112%,
				color-mix(in oklab, var(--color-accent) 12%, transparent),
				transparent 60%
			),
			linear-gradient(to bottom, var(--color-surface), var(--color-ink));
		animation: hero-drift 34s ease-in-out infinite alternate;
	}

	/* Fine horizontal rules — timing-screen rows, not scanlines. Masked to the
	   right of the text column so they add texture to the empty side of the
	   composition without sitting behind the type. */
	.hero__rules {
		background-image: repeating-linear-gradient(
			to bottom,
			color-mix(in oklab, var(--color-fg) 5%, transparent) 0 1px,
			transparent 1px 0.75rem
		);
		mask-image:
			linear-gradient(to right, transparent 38%, black 78%),
			linear-gradient(to bottom, transparent, black 22%, black 78%, transparent);
		mask-composite: intersect;
	}

	/*
	 * The cut. One decisive diagonal, which is the whole idea of the name.
	 * It is masked into the top-right corner deliberately: that region is empty
	 * at every breakpoint, so the line never crosses the wordmark or the pitch.
	 */
	.hero__cut {
		background-image: linear-gradient(
			118deg,
			transparent calc(78% - 0.5px),
			color-mix(in oklab, var(--color-accent) 85%, transparent) calc(78% - 0.5px),
			color-mix(in oklab, var(--color-accent) 85%, transparent) calc(78% + 0.5px),
			transparent calc(78% + 0.5px)
		);
		mask-image: radial-gradient(58% 78% at 100% 0%, black 15%, transparent 72%);
	}

	.hero__eyebrow {
		font-family: var(--font-mono);
		letter-spacing: 0.32em;
	}

	/* A short accent stroke anchoring the eyebrow to the left edge of the column. */
	.hero__tick {
		display: block;
		width: 1.75rem;
		height: 2px;
		flex: none;
		background-color: var(--color-accent);
	}

	.hero__wordmark {
		/* Optical tracking: display type at this size needs far less
		   letter-spacing than the body scale assumes. */
		letter-spacing: -0.045em;
		color: var(--color-fg);
	}

	/* Sized and lifted by hand rather than with `align-super`, which sets the
	   mark too low against a heavy display weight. `vertical-align` resolves
	   against this element's own font-size, hence the large-looking value. */
	.hero__tm {
		font-size: 0.19em;
		font-weight: 500;
		letter-spacing: 0;
		vertical-align: 2.9em;
		margin-inline-start: 0.15em;
	}

	@keyframes hero-drift {
		from {
			transform: translate3d(-1.5%, -1%, 0) scale(1.06);
		}
		to {
			transform: translate3d(1.5%, 1%, 0) scale(1.06);
		}
	}
</style>
